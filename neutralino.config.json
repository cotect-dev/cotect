{
  "applicationId": "com.cotect.app",
  "version": "0.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/",
  "url": "http://localhost:5173",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "computer.*",
    "debug.*",
    "storage.*",
    "events.*",
    "window.*",
    "clipboard.*"
  ],
  "modes": {
    "window": {
      "title": "Cotect",
      "width": 1280,
      "height": 768,
      "minWidth": 1280,
      "minHeight": 720,
      "center": true
    }
  },
  "cli": {
    "binaryName": "cotect",
    "resourceFile": "resources.neu",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/dist/__neutralino_globals.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.6.0"
  }
}
