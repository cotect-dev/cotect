{
  "name": "cotect",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "lint": "eslint .",
    "vite:dev": "vite",
    "vite:build": "tsc -b && vite build",
    "vite:preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cd tauri && cargo test",
    "test:all": "vitest run && cd tauri && cargo test",
    "eval": "COTECT_EVAL_KEEP_DIRS=true COTECT_EVAL_TRANSCRIPTS=/tmp/eval_transcripts ./scripts/eval-model.sh --endpoint http://server.local:8080/v1 --max-turns 100 --timeout 600 --model",
    "eval:medium": "COTECT_EVAL_KEEP_DIRS=true COTECT_EVAL_TRANSCRIPTS=/tmp/eval_transcripts ./scripts/eval-model.sh --endpoint http://server.local:8080/v1 --max-turns 100 --timeout 600 --difficulty medium --model",
    "eval:hard": "COTECT_EVAL_KEEP_DIRS=true COTECT_EVAL_TRANSCRIPTS=/tmp/eval_transcripts ./scripts/eval-model.sh --endpoint http://server.local:8080/v1 --max-turns 100 --timeout 600 --difficulty hard --model",
    "eval:xhard": "COTECT_EVAL_KEEP_DIRS=true COTECT_EVAL_TRANSCRIPTS=/tmp/eval_transcripts ./scripts/eval-model.sh --endpoint http://server.local:8080/v1 --max-turns 100 --timeout 600 --xhard --model",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.1",
