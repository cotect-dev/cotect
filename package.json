{
  "name": "cotect",
  "private": true,
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "fmt": "prettier --write 'src/**/*.{ts,tsx}' '*.{json,js,mjs}'",
    "fmt:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "lint": "eslint .",
    "vite:dev": "vite",
    "vite:build": "tsc -b && vite build",
    "vite:preview": "vite preview",
    "landing:dev": "vite -c vite.landing.config.ts",
    "landing:build": "tsc -b && vite build -c vite.landing.config.ts",
    "landing:preview": "vite preview -c vite.landing.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cd tauri && cargo test",
    "test:all": "vitest run && cd tauri && cargo test",
    "postinstall": "node scripts/sync-wasm.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  },
