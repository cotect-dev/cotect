#!/bin/bash
# Classic-confinement launcher. A classic snap runs against the host system, so
# the loader will not find the libraries we bundled inside the snap on its own.
# Point it at them, wire up the GTK helper stacks, then exec the app.
set -e

ARCH_LIB="$SNAP/usr/lib/x86_64-linux-gnu"

export LD_LIBRARY_PATH="$ARCH_LIB:$ARCH_LIB/webkit2gtk-4.1:$SNAP/usr/lib:${LD_LIBRARY_PATH:-}"
export GIO_MODULE_DIR="$ARCH_LIB/gio/modules"
export GSETTINGS_SCHEMA_DIR="$SNAP/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="$SNAP/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# webkit2gtk picks a black screen on some GPUs under a repacked runtime; the
# non-composited path is reliable for a read-only inspector.
export WEBKIT_DISABLE_COMPOSITING_MODE=1

# The staged gdk-pixbuf loader cache holds build-time absolute paths. Regenerate
# it once against the bundled loaders so icons and SVGs render.
PIXBUF_DIR="$ARCH_LIB/gdk-pixbuf-2.0/2.10.0"
if [ -d "$PIXBUF_DIR/loaders" ]; then
  CACHE="${SNAP_USER_DATA:-$HOME/.local/share/cotect}/gdk-pixbuf-loaders.cache"
  mkdir -p "$(dirname "$CACHE")"
  if [ ! -s "$CACHE" ]; then
    GDK_PIXBUF_MODULEDIR="$PIXBUF_DIR/loaders" \
      "$ARCH_LIB/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders" >"$CACHE" 2>/dev/null || true
  fi
  [ -s "$CACHE" ] && export GDK_PIXBUF_MODULE_FILE="$CACHE"
fi

exec "$@"
