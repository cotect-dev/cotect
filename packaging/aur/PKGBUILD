source=("https://github.com/cotect-dev/cotect/releases/download/v${pkgver}/Cotect_${pkgver}_amd64.deb")
sha256sums=('7a282e65f770fd3d1b9a5175e065947881a23e00c7247ad21e921d18d495430f')

package() {
