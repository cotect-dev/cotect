<!-- Lets software centers (GNOME Software / Ubuntu App Center) render Cotect's
     name, icon, description, and screenshots instead of a bare package. -->
<component type="desktop-application">
  <id>com.cotect.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Cotect</name>
  <summary>A fast, read-first code inspector for the agent era</summary>
  <description>
    <p>
      Cotect watches your repository while AI agents write. Every change lands on
      an infinite canvas the moment it happens, ready to review hunk by hunk,
      without touching the working tree.
    </p>
