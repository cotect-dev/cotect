  <url type="homepage">https://cotect.dev</url>
  <url type="bugtracker">https://github.com/cotect-dev/cotect/issues</url>
  <url type="vcs-browser">https://github.com/cotect-dev/cotect</url>
  <developer id="dev.cotect">
    <name>Grzegorz Raczek</name>
  </developer>
  <screenshots>
    <screenshot type="default">
      <image>https://cotect.dev/og.png</image>
      <caption>Cotect, a read-first code inspector for the agent era</caption>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1" />
  <releases>
    <release version="0.2.2" date="2026-06-15" />
